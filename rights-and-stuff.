  <style>

    .terms-wrap {
      max-width: 780px;
      margin: 0 auto;
      padding: 3.5rem 1.5rem 6rem;
    }

    /* ── Page header ─────────────────────────────── */
    .terms-eyebrow {
      font-family: var(--font-mono);
      font-size: .65rem;
      font-weight: 600;
      letter-spacing: .24em;
      text-transform: uppercase;
      color: var(--web);
      margin-bottom: .8rem;
      display: flex;
      align-items: center;
      gap: .6rem;
    }
    .terms-eyebrow::before {
      content: '';
      display: inline-block;
      width: 18px; height: 1px;
      background: var(--web);
    }

    .terms-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, 2.8rem);
      font-weight: 900;
      color: var(--ink);
      line-height: 1.15;
      margin-bottom: .6rem;
    }

    .terms-subtitle {
      font-family: var(--font-body);
      font-style: italic;
      font-size: 1.05rem;
      color: #6b5a45;
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    .terms-meta {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      padding: .9rem 0;
      border-top: 1px solid var(--cream);
      border-bottom: 1px solid var(--cream);
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }
    .terms-meta-item {
      font-family: var(--font-mono);
      font-size: .68rem;
      letter-spacing: .12em;
      color: var(--silver);
      text-transform: uppercase;
    }
    .terms-meta-item strong {
      color: var(--ink);
      font-weight: 600;
    }

    /* ── Important banner ────────────────────────── */
    .terms-banner {
      background: var(--ink);
      border-left: 4px solid var(--web);
      border-radius: 0 3px 3px 0;
      padding: 1.4rem 1.6rem;
      margin-bottom: 2.5rem;
    }
    .terms-banner-label {
      font-family: var(--font-mono);
      font-size: .62rem;
      font-weight: 600;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--web);
      margin-bottom: .5rem;
    }
    .terms-banner-text {
      font-family: var(--font-body);
      font-size: .97rem;
      color: #d4c4b0;
      line-height: 1.7;
    }
    .terms-banner-text strong {
      color: #fff;
      font-weight: 700;
    }

    /* ── Section headings ────────────────────────── */
    .terms-section {
      margin-bottom: 2.5rem;
    }

    .terms-section-number {
      font-family: var(--font-mono);
      font-size: .62rem;
      font-weight: 600;
      letter-spacing: .2em;
      color: var(--web);
      text-transform: uppercase;
      margin-bottom: .4rem;
    }

    .terms-section-title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 1rem;
      padding-bottom: .4rem;
      border-bottom: 1px solid rgba(200,0,42,.15);
    }

    .terms-body {
      font-family: var(--font-body);
      font-size: .97rem;
      line-height: 1.82;
      color: #2e2416;
    }
    .terms-body p {
      margin-bottom: 1rem;
    }
    .terms-body p:last-child {
      margin-bottom: 0;
    }
    .terms-body strong {
      color: var(--ink);
      font-weight: 700;
    }

    /* ── Key rights box ──────────────────────────── */
    .terms-rights-box {
      background: #fff;
      border: 1px solid var(--cream);
      border-radius: 3px;
      padding: 1.6rem 1.8rem;
      margin: 1.5rem 0;
    }
    .terms-rights-box-title {
      font-family: var(--font-mono);
      font-size: .65rem;
      font-weight: 600;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--silver);
      margin-bottom: 1rem;
    }
    .terms-rights-row {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: .6rem 1rem;
      align-items: start;
      margin-bottom: .6rem;
    }
    .terms-rights-row:last-child { margin-bottom: 0; }
    .terms-rights-mark {
      font-family: var(--font-mono);
      font-size: .85rem;
      font-weight: 700;
      margin-top: .1rem;
    }
    .terms-rights-mark.yes { color: #1a7a3a; }
    .terms-rights-mark.no  { color: var(--web); }
    .terms-rights-text {
      font-family: var(--font-body);
      font-size: .92rem;
      color: #2e2416;
      line-height: 1.6;
    }

    /* ── Acknowledgement box ─────────────────────── */
    .terms-ack {
      background: var(--ink);
      border-radius: 4px;
      padding: 2rem 2rem;
      margin-top: 3rem;
    }
    .terms-ack-title {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 900;
      color: #fff;
      margin-bottom: .8rem;
    }
    .terms-ack-body {
      font-family: var(--font-body);
      font-size: .92rem;
      color: #a89880;
      line-height: 1.75;
      margin-bottom: 1.4rem;
    }
    .terms-ack-body strong { color: var(--paper); }
    .terms-ack-note {
      font-family: var(--font-mono);
      font-size: .68rem;
      color: rgba(255,255,255,.3);
      letter-spacing: .08em;
      line-height: 1.6;
      border-top: 1px solid rgba(255,255,255,.07);
      padding-top: 1rem;
    }

    /* ── Divider ─────────────────────────────────── */
    .terms-divider {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 2.5rem 0;
      opacity: .4;
    }
    .terms-divider::before,
    .terms-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--web);
      opacity: .3;
    }
    .terms-divider svg { flex-shrink: 0; }

    /* ── Back link ───────────────────────────────── */
    .terms-back {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font-family: var(--font-mono);
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--silver);
      margin-bottom: 2.5rem;
      text-decoration: none;
      transition: color .2s;
    }
    .terms-back:hover { color: var(--web); text-decoration: none; }

  </style>
